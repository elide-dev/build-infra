{
  "name": "@elide-build-infra/client",
  "description": "Elide devops utility CLI",
  "version": "0.1.2",
  "type": "module",
  "module": "dist/client/client.mjs",
  "bin": {
    "elide-devops": "dist/client/client.mjs"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "client": "node ./dist/client/client.mjs",
    "client:bin": "./dist/elide-devops",
    "build": "bun run type-check && bun build --minify --compile --outfile=dist/elide-devops ./client.mts",
    "type-check": "tsc",
    "test": "bun test",
    "deploy": "wrangler deploy",
    "fmt": "biome format --write package.json actions ./*.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@cloudflare/workers-types": "4.20251111.0",
    "@types/byte-size": "8.1.2",
    "@types/node": "^24.10.1",
    "wrangler": "latest"
  },
  "dependencies": {
    "byte-size": "9.0.1",
    "commander": "14.0.2",
    "glob": "11.0.3",
    "simple-git": "3.30.0",
    "zod": "4.1.12"
  }
}
